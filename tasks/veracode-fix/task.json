    "category": "Build",
    "author": "JulianTotzek-Hallhuber",
    "version": {
        "Major": 1,
        "Minor": 0,
        "Patch": 0
    },
    "instanceNameFormat": "Apply Veracode Fix",
    "inputs": [
        {
            "name": "veracodeApiId",
