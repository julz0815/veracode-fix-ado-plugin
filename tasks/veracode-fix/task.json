            "label": "Veracode API ID",
            "defaultValue": "",
            "required": true,
            "helpMarkDown": "Your Veracode API ID"
        },
        {
            "name": "veracodeApiKey",
            "type": "string",
            "label": "Veracode API Key",
            "defaultValue": "",
            "required": true,
            "helpMarkDown": "Your Veracode API Key",
            "isSecret": true
        },
        // fixType parameter removed - now hardcoded to 'batch' in task.js
        {
            "name": "language",
            "type": "string",
            "label": "Programming Language",
            "defaultValue": "",
            "required": true,
            "helpMarkDown": "Programming language of the code to fix (e.g., java, python, javascript)"
        },
        {
            "name": "inputFile",
            "type": "string",
