            "label": "Pull Request Comment",
            "defaultValue": false,
            "required": false,
            "helpMarkDown": "Add a comment to the pull request"
        },
        {
            "name": "DEBUG",
            "type": "boolean",
            "label": "Enable Debug Logging",
            "defaultValue": false,
            "required": false,
            "helpMarkDown": "Enable verbose debug output for troubleshooting"
        }
    ],
    "execution": {
        "Node16": {
            "target": "task.js"
        }
