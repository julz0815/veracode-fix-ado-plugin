  "description": "Azure DevOps extension for Veracode Fix API integration",
  "scripts": {
    "build-service": "tsc --project tsconfig.service.json",
    "build-tabs": "webpack --config webpack.config.js",
    "copy-html": "cp src/pr-tab/veracode-fix-pr-tab.html dist/ && cp src/pipeline-tab/veracode-fix-pipeline-tab.html dist/",
    "build": "npm run build-service && npm run build-tabs && npm run copy-html",
    "dev": "echo 'No dev script needed'",
    "package": "tfx extension create",
    "increment-version": "node scripts/increment-version.js",
    "publish": "npm run increment-version && npm run build && npm run package && tfx extension publish --token C2nAhFpim2XE3CM6Lp5VGOXOWwc78CoaC2nwYKmJ9lSndwPNAnB1JQQJ99BDACAAAAAAAAAAAAASAZDO16FZ"
  },
